// klor -- generated from its matrix_transform. 44 keys.
// LAYOUT() takes the canonical 46 slots and keeps the 44 this board has.

#define LAYOUT( \
    l1, l2, l3, l4, l5, \
    r1, r2, r3, r4, r5, \
    l6, l7, l8, l9, l10, \
    r6, r7, r8, r9, r10, \
    l11, l12, l13, l14, l15, \
    r11, r12, r13, r14, r15, \
    lt1, lt2, lt3, rt1, rt2, \
    rt3, o1l, o1r, o2l, o2r, \
    o3l, o3r, midl, midr, t4l, \
    t4r)  \
      l1   l2   l3   l4   l5   r1   r2   r3   r4   r5 \
     o2l   l6   l7   l8   l9  l10   r6   r7   r8   r9  r10  o2r \
     o3l  l11  l12  l13  l14  l15 midl midr  r11  r12  r13  r14  r15  o3r \
     lt1  lt2  lt3  t4l  t4r  rt1  rt2  rt3

// hands, for hold-trigger-key-positions (cols 0-5 = left, 6+ = right)
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 \
               15 22 23 24 25 26 27 28 36 37 \
               38 39
#define KEYS_R 5 6 7 8 9 16 17 18 19 20 \
               21 29 30 31 32 33 34 35 40 41 \
               42 43

// key positions by canonical slot, for combos
#define POS_L1    0
#define POS_L2    1
#define POS_L3    2
#define POS_L4    3
#define POS_L5    4
#define POS_R1    5
#define POS_R2    6
#define POS_R3    7
#define POS_R4    8
#define POS_R5    9
#define POS_L6    11
#define POS_L7    12
#define POS_L8    13
#define POS_L9    14
#define POS_L10   15
#define POS_R6    16
#define POS_R7    17
#define POS_R8    18
#define POS_R9    19
#define POS_R10   20
#define POS_L11   23
#define POS_L12   24
#define POS_L13   25
#define POS_L14   26
#define POS_L15   27
#define POS_R11   30
#define POS_R12   31
#define POS_R13   32
#define POS_R14   33
#define POS_R15   34
#define POS_LT1   36
#define POS_LT2   37
#define POS_LT3   38
#define POS_RT1   41
#define POS_RT2   42
#define POS_RT3   43
#define POS_O2L   10
#define POS_O2R   21
#define POS_O3L   22
#define POS_O3R   35
#define POS_MIDL  28
#define POS_MIDR  29
#define POS_T4L   39
#define POS_T4R   40

#define HAS_ENCODER
#define HAS_OUTER_R3
// HAS_GAMING and HAS_QWERTY are not set here. All three klors share this
// file because they are the same board electrically, but they don't all
// want the same optional layers, so each one sets that in its own keymap.
